# Runtime settings for the local Oculox EJBCA service.
#
# Copy this file to dev/ejbca/config/ejbca.env or let
# ./oculox pki-ca init create a generated runtime file.
# Never commit the real env file.

OCULOX_EJBCA_IMAGE=keyfactor/ejbca-ce@sha256:ef574ed81c1e2bb335902f1097b09f9408fe32f2c3abbccfe80999d1c9b50164
OCULOX_EJBCA_DB_IMAGE=mariadb:10.11

# Bind EJBCA only on localhost by default. Oculox services do not consume it
# directly in phases 3 and 4.
OCULOX_EJBCA_BIND_ADDRESS=127.0.0.1
OCULOX_EJBCA_HTTP_PORT=18080
OCULOX_EJBCA_HTTPS_PORT=18443

OCULOX_EJBCA_HOSTNAME=oculox-ejbca.local
OCULOX_EJBCA_MEMORY_LIMIT=2g
OCULOX_EJBCA_DB_MEMORY_LIMIT=1g

EJBCA_DATABASE_NAME=ejbca
EJBCA_DATABASE_USER=ejbca
EJBCA_DATABASE_PASSWORD=change-me-generate-with-oculox-pki-ca-init
EJBCA_DATABASE_ROOT_PASSWORD=change-me-generate-with-oculox-pki-ca-init
EJBCA_CA_TOKEN_PASSWORD=change-me-generate-with-oculox-pki-ca-init

# Local certificate administrator created by:
# ./oculox pki-ca harden
#
# The generated P12 is written under dev/ejbca/generated/admin/ and must never
# be committed. The DN contains spaces; keep this file as a Docker .env file,
# not as a Bash script.
EJBCA_ADMIN_USERNAME=oculox-superadmin
EJBCA_ADMIN_CN=OculoxSuperAdmin
EJBCA_ADMIN_DN=CN=OculoxSuperAdmin,OU=Oculox PKI Administration,O=Oculox,C=SN
EJBCA_ADMIN_CA=ManagementCA
EJBCA_ADMIN_PASSWORD=change-me-generate-with-oculox-pki-ca-init

# EJBCA container options. TLS_SETUP_ENABLED=simple lets the container bootstrap
# its own admin access material for first setup. Production hardening is handled
# after the initial bootstrap.
TLS_SETUP_ENABLED=simple
