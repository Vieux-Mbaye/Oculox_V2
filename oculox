  ./oculox keycloak verify-dashboards
  ./oculox keycloak verify-hardening
  ./oculox keycloak credentials
  ./oculox keycloak report
  ./oculox verify clients
  ./oculox verify ingestion baseline --output <rapport-core.json>
  ./oculox verify ingestion inject --pcap <fichier.pcap> \
      --run-id <identifiant> --output <rapport-collecteur.json>
  ./oculox verify ingestion finalize --baseline <rapport-core.json> \
