Exploitation :
  ./oculox start
  ./oculox restart [service...]
  ./oculox stop
  ./oculox status
  ./oculox logs [service...]
  ./oculox pull
  ./oculox validate
  ./oculox validate pki
  ./oculox validate web|keycloak|dashboards|opensearch|ingestion|all
  ./oculox pki audit
  ./oculox pki status
  ./oculox pki expiry
  ./oculox pki agent-init --role cluster|collector --identity <nom>
