  ./oculox pki renew --provider ejbca --service <entrée-manifest> [--install] [--restart]
  ./oculox pki import --provider customer --bundle <répertoire-bundle> [--service <entrée-manifest>] [--install] [--restart]
  ./oculox pki-ca init|config|pull|start|stop|restart|status|logs|validate|ca-plan|create-ca-plan|provision-profiles|configure-api|harden|verify-hardening
  ./oculox pki-ca authorize-agent --role cluster|collector --identity <nom> --csr <CSR> --output <répertoire>
  ./oculox pki-ca revoke-agent --role cluster|collector --identity <nom>
  ./oculox pki-ca backup|backup-check|restore --help
  ./oculox collector-bundle <nom-collecteur> <nom-DNS-ou-IP-principal> [sortie]
  ./oculox configure-opensearch-remote --bundle <répertoire-bundle>
